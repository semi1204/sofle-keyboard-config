#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <50>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        ctrl_rclick: ctrl_rclick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&mkp>;
            display-name = "Ctrl / Right Click";
        };

        auto_option: auto_option {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LEFT_ALT>, <&kp LEFT_GUI>;
            display-name = "Auto Option / Win";
        };

        auto_command: auto_command {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LEFT_GUI>, <&kp LEFT_ALT>;
            display-name = "Auto Command / Alt";
        };

        // Windows host remaps raw RAlt/SC138 to Ctrl and LGUI to ordinary LAlt.
        auto_space: auto_space {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&mt RIGHT_GUI SPACE>, <&mt RIGHT_ALT SPACE>;
            display-name = "Auto Space / Cmd-Ctrl";
        };

        space_shift: space_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Space / Shift";
        };

        space_fn2: space_fn2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
            display-name = "Space / Fn2";
        };

        auto_right_command: auto_right_command {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp RIGHT_GUI>, <&kp RIGHT_ALT>;
            display-name = "Auto Right Command / Ctrl";
        };

        auto_right_alt: auto_right_alt {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp RIGHT_ALT>, <&kp LEFT_GUI>;
            display-name = "Auto Right Alt / Alt";
        };

        b_layer: b_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "B / Layer";
        };

        auto_b: auto_b {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&b_layer 6 B>, <&b_layer 2 B>;
            display-name = "Auto B / Mac-Win Layer";
        };

        auto_back: auto_back {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LEFT_BRACKET)>, <&kp C_AC_BACK>;
            display-name = "Auto Back";
        };

        auto_forward: auto_forward {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(RIGHT_BRACKET)>, <&kp C_AC_FORWARD>;
            display-name = "Auto Forward";
        };

        // This Windows host maps raw Left Alt to Ctrl.
        auto_previous_tab: auto_previous_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LS(LEFT_BRACKET))>, <&kp LA(PG_UP)>;
            display-name = "Auto Previous Tab";
        };

        auto_next_tab: auto_next_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LS(RIGHT_BRACKET))>, <&kp LA(PG_DN)>;
            display-name = "Auto Next Tab";
        };

        auto_window_left: auto_window_left {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LA(LEFT_BRACKET)>, <&kp LC(LEFT)>;
            display-name = "Auto Window Left";
        };

        auto_window_right: auto_window_right {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LA(RIGHT_BRACKET)>, <&kp LC(RIGHT)>;
            display-name = "Auto Window Right";
        };

        layer_click: layer_click {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
            display-name = "Layer Click";
        };

        rate_scroll: rate_scroll {
            compatible = "zmk,behavior-rate-scroll";
            #binding-cells = <1>;
            scroll-behavior = <&msc>;
            pulse-ms = <100>;
            display-name = "Rate Scroll";
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
            cw-binding = <&rate_scroll MOVE_Y(-30)>;
            ccw-binding = <&rate_scroll MOVE_Y(30)>;
        };

        rsr_history: rsr_history {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&auto_forward>;
            ccw-binding = <&auto_back>;
        };

        rsr_horizontal: rsr_horizontal {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <100>;
            cw-binding = <&msc MOVE_X(40)>;
            ccw-binding = <&msc MOVE_X(-40)>;
        };

        rsr_tabs: rsr_tabs {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <100>;
            cw-binding = <&kp LC(PG_DN)>;
            ccw-binding = <&kp LC(PG_UP)>;
        };

        rsr_tabs_mac: rsr_tabs_mac {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <100>;
            cw-binding = <&kp LG(LS(RIGHT_BRACKET))>;
            ccw-binding = <&kp LG(LS(LEFT_BRACKET))>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_sd_symbols {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&mo 3>;
            layers = <0>;
        };
        combo_jn_symbols {
            timeout-ms = <50>;
            key-positions = <34 46>;
            bindings = <&mo 4>;
            layers = <0>;
        };
        combo_kl_option {
            timeout-ms = <50>;
            key-positions = <35 36>;
            bindings = <&mo 8>;
            layers = <0>;
        };
        combo_df_command {
            timeout-ms = <50>;
            key-positions = <29 30>;
            bindings = <&kp RIGHT_GUI>;
            layers = <0>;
        };
        combo_jk_delete_word {
            timeout-ms = <50>;
            key-positions = <34 35>;
            bindings = <&delete_word>;
            layers = <0>;
        };
        combo_jl_delete_line {
            timeout-ms = <50>;
            key-positions = <34 36>;
            bindings = <&delete_line>;
            layers = <0>;
        };
        combo_zx_caps_lock {
            timeout-ms = <50>;
            key-positions = <40 41>;
            bindings = <&kp CAPS>;
            layers = <0>;
        };
        combo_xc_escape {
            timeout-ms = <30>;
            key-positions = <41 42>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
        combo_paste_style {
            timeout-ms = <50>;
            key-positions = <37 38>;
            bindings = <&kp LG(LS(V))>;
            layers = <0>;
        };
        combo_qw_escape {
            timeout-ms = <30>;
            key-positions = <14 15>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
        combo_comma_dot_enter {
            timeout-ms = <50>;
            key-positions = <48 49>;
            bindings = <&kp ENTER>;
            layers = <0>;
        };

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        bt_channel_1: bt_channel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 0 &out OUT_BLE>;
            display-name = "Bluetooth 1 (Mac)";
        };
        bt_channel_2: bt_channel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 1 &out OUT_BLE>;
            display-name = "Bluetooth 2 (Windows)";
        };

        pair_parens: pair_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };
        pair_braces: pair_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };
        pair_brackets: pair_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };
        pair_double_quotes: pair_double_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
        };
        pair_single_quotes: pair_single_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp APOS &kp APOS &kp LEFT>;
        };
        pair_angles: pair_angles {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LT &kp GT &kp LEFT>;
        };
        delete_word: delete_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LA(LEFT) &kp LA(LS(RIGHT)) &kp BACKSPACE>;
        };
        delete_line: delete_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LG(LEFT) &kp LG(LEFT) &kp LS(DOWN) &kp BACKSPACE>;
        };
        symbol_arrow: symbol_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp EQUAL &kp GT>;
        };
        symbol_and: symbol_and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp AMPERSAND &kp AMPERSAND>;
        };
        symbol_or: symbol_or {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp PIPE &kp PIPE>;
        };

        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &auto_previous_tab  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSLH
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &auto_next_tab  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BACKSPACE
&kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &auto_back  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp ENTER
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &auto_forward  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
&kp LC(LEFT_ALT)  &auto_option  &auto_command  &kp SPACE  &mo 1  &mkp LCLK  &layer_click 3 LCLK  &ctrl_rclick LCTRL RCLK  &auto_b  &space_fn2 2 SPACE  &auto_right_command  &auto_right_alt
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &mmv MOVE_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp DELETE
&trans  &kp GRAVE  &kp MINUS  &kp KP_PLUS  &kp STAR  &kp FSLH  &mmv MOVE_DOWN  &kp PG_UP  &kp LA(LEFT)  &kp UP  &kp N7  &kp N8  &kp N9
&trans  &kp EXCL  &kp APOS  &none  &kp EQUAL  &kp DLLR  &mmv MOVE_LEFT  &kp LG(LEFT)  &kp LEFT  &kp DOWN  &kp N4  &kp N5  &kp N6
&trans  &kp TILDE  &kp PIPE  &kp HASH  &kp AMPS  &kp BSLH  &mmv MOVE_RIGHT  &kp COLON  &kp COMMA  &kp DOT  &kp N1  &kp N2  &kp N3
&kp LEFT_ALT  &trans  &trans  &trans  &trans  &none  &none  &none  &trans  &kp RIGHT_SHIFT  &kp LG(RIGHT_BRACKET)  &kp N0
            >;

            sensor-bindings = <&rsr_history &rsr_trans>;
            display-name = "LAYER1";
        };

        layer_2 {
            bindings = <
&kp TILDE  &bt_channel_1  &bt_channel_2  &kp F3  &kp F4  &kp F5  &mmv MOVE_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp TAB
&kp TAB  &trans  &kp C_VOL_DN  &kp C_VOL_UP  &kp LEFT_ALT  &trans  &mmv MOVE_DOWN  &kp LA(LEFT)  &kp UP  &kp LA(RIGHT)  &kp LC(RIGHT)  &kp LEFT  &kp TAB
&kp CAPS  &kp C_PLAY_PAUSE  &kp LG(LEFT_BRACKET)  &kp LG(BSLH)  &kp LG(RIGHT_BRACKET)  &trans  &mmv MOVE_LEFT  &kp LEFT  &kp DOWN  &kp RIGHT  &kp RIGHT  &kp LBRC  &kp RBRC
&kp LSHFT  &trans  &trans  &trans  &trans  &trans  &mmv MOVE_RIGHT  &kp LC(MINUS)  &kp LC(EQUAL)  &kp LC(N0)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none  &none  &none  &trans  &trans  &trans  &trans
            >;

            display-name = "LAYER2";
            sensor-bindings = <&rsr_tabs &rsr_trans>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &pair_double_quotes  &pair_single_quotes  &kp MINUS  &kp PLUS  &trans
&trans  &kp EXCL  &trans  &trans  &kp QMARK  &trans  &trans  &symbol_arrow  &pair_parens  &pair_braces  &pair_brackets  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &symbol_and  &kp COLON  &symbol_or  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp UNDER  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "LAYER3";
            sensor-bindings = <&rsr_horizontal &rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp AT  &kp HASH  &kp DLLR  &kp TILDE  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp STAR  &kp GRAVE  &kp EXCL  &pair_angles  &kp UNDER  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "LAYER4";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
        layer_5 {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &mmv MOVE_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &bt BT_CLR  &bt BT_CLR_ALL  &trans  &trans  &trans  &mmv MOVE_DOWN  &trans  &trans  &kp F11  &kp F12  &kp UNDER  &kp PLUS
&trans  &out OUT_USB  &out OUT_BLE  &trans  &trans  &trans  &mmv MOVE_LEFT  &trans  &trans  &trans  &trans  &kp LBRC  &kp RBRC
&trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &sys_reset  &soft_off  &bootloader  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "MANAGE";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_6 {
            bindings = <
&kp TILDE  &bt_channel_1  &bt_channel_2  &kp F3  &kp F4  &kp F5  &mmv MOVE_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&mo 7  &trans  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &trans  &mmv MOVE_DOWN  &kp F11  &kp LA(LEFT)  &kp UP  &kp LA(RIGHT)  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)
&trans  &kp C_PLAY_PAUSE  &kp LA(LEFT_BRACKET)  &kp LA(BSLH)  &kp LA(RIGHT_BRACKET)  &trans  &mmv MOVE_LEFT  &kp LG(LEFT_BRACKET)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LBRC  &kp RBRC
&trans  &trans  &trans  &trans  &trans  &trans  &mmv MOVE_RIGHT  &kp LG(MINUS)  &kp LG(EQUAL)  &kp LG(N0)  &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_SHIFT  &trans  &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "MAC";
            sensor-bindings = <&rsr_tabs_mac &rsr_trans>;
        };

        layer_7 {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &mmv MOVE_UP  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &bt BT_CLR  &bt BT_CLR_ALL  &trans  &trans  &trans  &mmv MOVE_DOWN  &trans  &trans  &kp F11  &kp F12  &kp UNDER  &kp PLUS
&trans  &out OUT_USB  &out OUT_BLE  &trans  &trans  &trans  &mmv MOVE_LEFT  &trans  &trans  &trans  &trans  &kp LBRC  &kp RBRC
&trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &sys_reset  &soft_off  &bootloader  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "MAC MANAGE";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &auto_window_left  &trans  &trans  &auto_window_right  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "WINDOW SPLIT";
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };
    };
};
